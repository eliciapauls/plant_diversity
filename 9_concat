##to merge all gvcfs or vcfs in a directory, just match the suffix in the concat command to the compiled vcf or gvcf

#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=16G
#SBATCH --time=00-23:00:00
#SBATCH --account=def-yeaman

module load StdEnv/2020 gcc/9.3.0 bcftools/1.11
 
bcftools concat -Ov /home/elicia/scratch/murray_Esideroxylon/final_bams/*.g.vcf.gz > /home/elicia/scratch/murray_Esideroxylon/final_bams/Esideroxylonmerged.g.vcf.gz
